# fragments/accel/rk3576-rga.config -- RK3576 2D raster accelerator (RGA).
#
# Compiles the out-of-tree vendor multicore RGA driver added by the rk3576-rga
# patch series. That series also adds the two RGA2 core nodes to rk3576.dtsi;
# this fragment is what turns the driver itself on, so the two travel together.
#
# The module is rga3.ko regardless of core generation -- the vendor driver keeps
# one module name for both the RGA2 and RGA3 register backends, and the RK3576's
# cores are RGA2.
CONFIG_ROCKCHIP_MULTI_RGA=m

# The in-tree V4L2 RGA driver is left off. It binds "rockchip,rk3288-rga"-family
# compatibles, which no RK3576 node carries, so it would build a module that can
# never bind; more to the point, the two drivers claim the same hardware and only
# the vendor ABI is what librga speaks.
# CONFIG_VIDEO_ROCKCHIP_RGA is not set
