# fragments/accel/rk3576-npu.config -- RK3576 NPU (rocket) enablement.
#
# Turns on the mainline in-tree `rocket` DRM-accel driver and the Rockchip IOMMU
# it binds through. Consumed only by a board that opts the NPU in (the
# h96-max-m9-npu device variant), so the shipping RK3576 kernel stays lean.
#
# The rocket Kconfig (drivers/accel/rocket/Kconfig) gates on DRM_ACCEL,
# ROCKCHIP_IOMMU, ARCH_ROCKCHIP && ARM64, and MMU; the first two are not otherwise
# pinned for RK3576, so name them here. The RK3576 support itself comes from the
# rk3576-npu patch profile (the driver's of_device_id match data + the NPU DT
# nodes); this fragment only compiles the driver in.
#
# Experimental: binding the driver exposes the accel uAPI (/dev/accel) for register
# probing and job submission; it is not a working accelerator (the RK3576 compute
# datapath does not yet run inference correctly).
CONFIG_DRM_ACCEL=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_DRM_ACCEL_ROCKET=m
