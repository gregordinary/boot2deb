# device/nanopi-r6s -- NanoPi R6S and R6C board-specific kernel config.
#
# Both boards enable the SoC's `hdmi0_sound` card, whose CPU side is `i2s5_8ch`, an
# I2S/TDM controller (`rockchip,rk3588-i2s-tdm`). The shared RK3588 configuration has
# no driver for it, since the Turing RK1 enables no HDMI. Without it the sound card's
# probe defers for good and the HDMI output has no audio.
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m
