# device/h96-max-m9 -- H96 MAX M9 board-specific kconfig.
#
# The board's Wi-Fi is an AICSemi AIC8800D80 on SDIO, driven by an out-of-tree module
# built from radxa-pkg/aic8800 (see the device's `[[device_kmods]]` block). The driver
# is external, so it needs no in-tree kconfig -- its build knobs (NO_REG_SDIO, BTLPM
# off) live in the kmod `make_args`. This fragment carries only the board deltas the
# in-tree kernel still owns: the regulatory-DB signature relaxation the driver's radio
# needs, and the IR receiver.

# Load the regulatory database without signature enforcement. The upstream default
# requires regulatory.db to be signed by a key compiled into the kernel; a
# self-built kernel does not carry the key that signed the distro's database, so
# cfg80211 rejects it ("regulatory.db is malformed or signature is missing/invalid")
# and falls back to the world domain "00", under which the AIC radio's 5 GHz band is
# disabled. Unsetting this makes the kernel load the distro database as-is, so a
# regulatory country (set via the cfg80211 overlay) takes effect and 5 GHz enables.
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set

# IR remote receive for the bundled handset, whose demodulated output is a plain
# GPIO on this board (GPIO0_C4 -- see the &ir_receiver node in the .dts). rc-core
# decodes it: gpio-ir-receiver times the edges, the NEC decoder rebuilds the
# scancode, and LIRC exposes the raw device for `ir-keytable -t` capture. The base
# arm64 defconfig already carries all of these; named here so the board's IR
# support cannot silently regress on a defconfig change. Board-specific because the
# IR receiver + handset are this board's, not the SoC's -- the evb1 validator has
# neither. rc-core itself is deliberately absent from this list: the SoC layer builds
# it in for CEC remote-control integration, and fragments are last-wins with the
# device narrower than the SoC, so naming it as a module here would take that away.
CONFIG_LIRC=y
CONFIG_RC_DECODERS=y
CONFIG_IR_NEC_DECODER=m
CONFIG_IR_GPIO_CIR=m
