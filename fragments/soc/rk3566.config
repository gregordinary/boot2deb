# socs/rk3566 -- RK3566 platform drivers.
# The arm64 `defconfig` already enables every driver an RK3566 board needs to boot from
# microSD and reach Ethernet, USB, HDMI, the GPU and the video blocks. This fragment
# names them anyway, so `verify-config` reports it if the shared base fragment or a
# defconfig change ever drops one. Only prompted symbols are named; see
# fragments/README.md.

# PMIC and regulators: the RK817 on I2C (with its clock outputs), and the RK8600 that
# feeds the CPU cores, a FAN53555-compatible part. All built in, because the microSD
# card's I/O rail comes from the RK817 and the root filesystem is on the card.
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_ROCKCHIP_IODOMAIN=y

# Storage: the microSD slot is a dw_mmc controller. Built in, for the same reason.
CONFIG_MMC_DW_ROCKCHIP=y

# CPU and GPU clocks come from the BL31 over SCMI, so cpufreq and panfrost depend on it.
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_COMMON_CLK_SCMI=y

# Networking: the SoC's GMAC.
CONFIG_DWMAC_ROCKCHIP=m

# USB: the USB 2.0 PHY, and the Naneng combo PHY that carries the USB 3.0 lane.
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=m

# Display: VOP2 with the DesignWare HDMI TX, and the Mali-G52 via panfrost. The G52 is a
# Bifrost part, so it needs no firmware blob.
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_DRM_PANFROST=m

# HDMI audio is carried over the SoC's I2S/TDM controller.
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m

# Video: hantro decode (H.264, MPEG-2, VP8) and JPEG encode, and the RGA2.
CONFIG_VIDEO_HANTRO=m
CONFIG_VIDEO_HANTRO_ROCKCHIP=y
CONFIG_VIDEO_ROCKCHIP_RGA=m

# SoC housekeeping.
CONFIG_ROCKCHIP_SARADC=m
CONFIG_ROCKCHIP_THERMAL=m
CONFIG_NVMEM_ROCKCHIP_OTP=y
