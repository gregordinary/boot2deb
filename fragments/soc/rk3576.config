# socs/rk3576 -- RK3576 platform drivers (minimal bring-up slice).
# The arm64 `defconfig` already enables ARCH_ROCKCHIP and most shared Rockchip
# drivers; this fragment names the RK3576 essentials so a first boot has PMIC,
# eMMC, Ethernet, GPU, display, and V4L2 stateless decode. It is a starting point
# the raw bring-up loop refines -- add symbols as each peripheral is validated.

# PMIC / regulators (RK806 over SPI).
CONFIG_MFD_RK8XX_SPI=y
CONFIG_REGULATOR_RK808=y
CONFIG_COMMON_CLK_RK808=y

# Storage: eMMC (HS400-ES) via the Rockchip dw_mmc / sdhci.
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# Networking: Rockchip GMAC.
CONFIG_DWMAC_ROCKCHIP=y

# USB combo PHY (USB2 + USB3) and Naneng combo PHY. usb_drd1's SuperSpeed lane
# rides combphy1_psu, so the Naneng driver is needed for USB3 on that port.
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_USBDP=y

# Display: VOP2 + HDMI TX, and the Mali-G52 (Bifrost) GPU via Panfrost. G52 is a
# non-CSF part, so it needs no firmware blob.
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_DRM_PANFROST=m

# HDMI-CEC on the DW-HDMI-QP controller. The RK3576 HDMI block has a CEC adapter
# and the SoC dtsi already wires its "cec" interrupt and the vo-grf CEC mux, so
# turning on the QP CEC support exposes /dev/cecN for HDMI device control -- e.g.
# the box waking or standby-ing a CEC-capable TV. Off in the base defconfig; the
# CEC core (CEC_CORE=y) and the HDMI-CEC helper it selects are already enabled.
CONFIG_DRM_DW_HDMI_QP_CEC=y

# HW video decode: V4L2 stateless via the Rockchip VDPU (VDPU383 on RK3576).
CONFIG_VIDEO_ROCKCHIP_VDEC=m

# SoC housekeeping shared with other Rockchip parts.
CONFIG_NVMEM_ROCKCHIP_OTP=m
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ROCKCHIP_SARADC=m

# Reboot-mode: lets `reboot loader` write the Rockchip boot flag to PMU0_GRF so
# mainline u-boot re-enters the rockusb (loader) USB-flash gadget on the next
# boot. Pairs with the board .dts syscon-reboot-mode node and the rk3576-loader
# u-boot profile. Generic Rockchip infra -- harmless on a board with no node.
# The base arm64 defconfig already sets this; named here as an explicit guard
# against defconfig drift and to document the loader path's dependency.
CONFIG_SYSCON_REBOOT_MODE=y

# PSCI checker OFF: the shared base fragment enables this boot-time CPU
# hotplug/suspend self-test, but on RK3576 a CPU suspended into the DT's
# CPU_SLEEP idle state can lose its timer wakeup, and the checker's intensive
# suspend cycling turns that into an RCU stall that hangs boot (nondeterministic;
# hotplug tests pass, the suspend half wedges). The wakeup loss itself is a
# platform issue (BL31/idle-state side, under investigation) that also shows up
# as intermittent recovered RCU stalls under normal cpuidle; the checker just
# makes it fatal at every boot.
# CONFIG_ARM_PSCI_CHECKER is not set
