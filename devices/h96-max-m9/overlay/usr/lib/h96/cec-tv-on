#!/bin/sh
# Box drives the TV: on boot, wake a CEC-capable TV and switch it to this input.
#
# One Touch Play over HDMI-CEC. Configure this adapter as a Playback device (the
# kernel fills its physical address from the connected sink's EDID), send Image View
# On to the TV (CEC logical address 0), then announce this device as the active
# source. --active-source carries this adapter's own physical address, so read the
# configured value back and pass it; when no CEC-capable sink is attached the address
# is unconfigured (f.f.f.f) and the active-source announcement is skipped. cec-ctl
# leaves the adapter configured between invocations, so the calls compose. Flags are
# validated on hardware; override CEC_DEV if the adapter is not cec0.
set -eu
CEC_DEV=${CEC_DEV:-/dev/cec0}

cec-ctl -d "$CEC_DEV" --playback >/dev/null
cec-ctl -d "$CEC_DEV" --to 0 --image-view-on

pa=$(cec-ctl -d "$CEC_DEV" | awk '/Physical Address/{print $NF; exit}')
if [ -n "$pa" ] && [ "$pa" != "f.f.f.f" ]; then
	cec-ctl -d "$CEC_DEV" --active-source phys-addr="$pa"
fi
