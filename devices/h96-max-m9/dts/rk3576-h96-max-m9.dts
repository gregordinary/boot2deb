// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * H96 MAX M9 / M9S — RK3576 Android TV box.
 *
 * The board is a lightly-modified Rockchip RK3576 EVB1 V10: eMMC, microSD,
 * SDIO Wi-Fi, one RGMII Ethernet port, HDMI, and an HT5010 amplifier on the
 * 3.5 mm AV jack. It differs from the EVB in Ethernet RGMII TX timing, the PHY
 * reset pin, the HDMI data-line bias pin, two status LEDs, a power button, and
 * a Wi-Fi part that sits on SDIO rather than PCIe.
 *
 * DRAM is LPDDR4X-2112, dual-channel, 8 GiB. Wi-Fi/BT is an AIC8800D80, whose
 * driver is out of tree; the SDIO bus and its power sequencing are described
 * here so the module enumerates, but no in-tree driver claims it.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3576.dtsi"

/ {
	model = "H96 MAX M9 (RK3576)";
	compatible = "h96,max-m9", "rockchip,rk3576";

	aliases {
		ethernet0 = &gmac0;
	};

	chosen: chosen {
		stdout-path = "serial0:1500000n8";
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pwr_key>;

		key-power {
			debounce-interval = <100>;
			gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_LOW>;
			label = "power";
			linux,code = <KEY_POWER>;
			wakeup-source;
		};
	};

	/*
	 * IR receiver for the bundled infrared handset. The demodulated signal sits
	 * on GPIO0_C4 -- the SoC's PWM0 IR-capture pin, which the vendor kernel drove
	 * with its out-of-tree pwm-remotectl block. Mainline has no such driver, so the
	 * pin is used as a plain GPIO and rc-core software-decodes the frames:
	 * gpio-ir-receiver times the edges, the NEC decoder rebuilds the scancode, and
	 * ir-keytable applies the h96 keymap (recovered from the vendor device tree,
	 * shipped in the device overlay). The demodulator idles high and pulls low on
	 * carrier, hence active-low; it starts on the empty built-in map, which
	 * userspace replaces.
	 */
	ir_receiver: ir-receiver {
		compatible = "gpio-ir-receiver";
		gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
		linux,rc-map-name = "rc-empty";
		pinctrl-names = "default";
		pinctrl-0 = <&ir_receiver_pin>;
	};

	hdmi-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	leds: leds {
		compatible = "gpio-leds";

		/* Physically white on this board (observed); the EVB names it green. */
		white_led: led-0 {
			color = <LED_COLOR_ID_WHITE>;
			default-state = "on";
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 RK_PD1 GPIO_ACTIVE_LOW>;
		};

		red_led: led-1 {
			color = <LED_COLOR_ID_RED>;
			default-state = "off";
			function = LED_FUNCTION_STANDBY;
			gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * The Wi-Fi module's reset line (WL_REG_ON). `vcc_wifi_reg_on` gates the
	 * module's supply; the reset here is a separate pin. The chip needs time to
	 * come out of reset before the controller probes it at boot -- too short a
	 * delay loses the boot-time enumeration to a power-on race (the card then
	 * only appears on a later re-probe), so hold 500 ms after releasing reset.
	 */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		post-power-on-delay-ms = <500>;
		reset-gpios = <&gpio0 RK_PD2 GPIO_ACTIVE_LOW>;
	};

	vcc12v_dcin: regulator-vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc5v0_device: regulator-vcc5v0-device {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_device";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_host: regulator-vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_device>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_host_pwren>;
	};

	vcc_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc3v3_rtc_s5: regulator-vcc3v3-rtc-s5 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_rtc_s5";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_1v1_nldo_s3: regulator-vcc-1v1-nldo-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v1_nldo_s3";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_1v8_s0: regulator-vcc-1v8-s0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8_s0";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_1v8_s3>;
	};

	vcc_2v0_pldo_s3: regulator-vcc-2v0-pldo-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_2v0_pldo_s3";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <2000000>;
		regulator-max-microvolt = <2000000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_3v3_s0: regulator-vcc-3v3-s0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_s0";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	vcc_wifi_reg_on: regulator-wifi-reg-on {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio1 RK_PC6 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&wifi_reg_on>;
		pinctrl-names = "default";
		regulator-name = "wifi_reg_on";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_1v8_s3>;
	};

	/*
	 * Analog line-out on the 3.5 mm jack. The amplifier is an HT5010, a
	 * control-less part with no I2C interface, so it is modelled as a dummy
	 * codec (linux,spdif-dit): SAI1 drives it over I2S and provides the master
	 * clock. SAI1 is wired to sdo2 on this board (see &sai1), not the EVB's sdo0.
	 *
	 * The EVB's ES8388 at i2c3 0x10 is not this board's codec and i2c3 is left
	 * disabled: nothing answers on that bus, on this stack or the vendor's.
	 *
	 * The amplifier's enable pins are not described. gpio2 PB1 (speaker) and
	 * gpio3 PD6 (headphone) are what the EVB drives as simple-audio-amplifier
	 * aux-devs, and the factory tree names the same two pins -- but only on a
	 * sound card that never probes, so no capture shows either driven. Adding
	 * them is the first thing to try if the card plays silence.
	 */
	analog_dummy: analog-codec {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	analog_sound: analog-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "H96 Analog";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;

		/*
		 * The `clocks` reference is what ungates MCLK to the pin.
		 * CLK_SAI1_MCLKOUT_TO_IO is a GRF gate, and nothing enables it
		 * implicitly: `assigned-clocks` above fixes its rate but never its
		 * enable state, and the SAI driver only enables the clocks it looks
		 * up by name ("mclk", "hclk"). simple-audio-card reads `clocks` from
		 * this sub-node and holds it prepared for the life of the stream,
		 * which is the role the EVB's ES8388 node plays on a board that has
		 * an I2C codec to carry the reference.
		 */
		simple-audio-card,cpu {
			sound-dai = <&sai1>;
			clocks = <&cru CLK_SAI1_MCLKOUT_TO_IO>;
		};

		simple-audio-card,codec {
			sound-dai = <&analog_dummy>;
		};
	};

	/*
	 * S/PDIF out. The transmitter has no receiver to describe, so it too takes
	 * a dummy DIT codec; SPDIF_TX1 drives the board's m1 pin group (see
	 * &spdif_tx1).
	 */
	spdif_dummy: spdif-codec {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	spdif_sound: spdif-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "H96 SPDIF";
		simple-audio-card,mclk-fs = <128>;

		simple-audio-card,cpu {
			sound-dai = <&spdif_tx1>;
		};

		simple-audio-card,codec {
			sound-dai = <&spdif_dummy>;
		};
	};
};

&cpu_l0 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_b0 {
	cpu-supply = <&vdd_cpu_big_s0>;
};

/*
 * Only combphy1_psu runs. The two naneng serdes PHYs each back a PCIe controller,
 * a SATA port, and (for combphy1_psu alone) usb_drd1's SuperSpeed lane. This board
 * brings up no PCIe and no SATA, so combphy0_ps has no consumer at all and stays
 * disabled; combphy1_psu is enabled because usb_drd1_dwc3 names it as its
 * "usb3-phy". That PHY logs `wait phy status ready timeout` on every boot and no
 * device has ever trained at SuperSpeed on this board -- see the usb_drd1 note.
 *
 * Keeping it enabled may also be what keeps usb_drd1's *high* speed working: the
 * SoC design guide (2.3.4.2) states that with this combo PHY muxed to PCIe or
 * SATA, the controller's USB2 PHY is unusable as well.
 */
&combphy1_psu {
	status = "okay";
};

/*
 * RGMII TX clock skew is a board trace-length property: 0x1b, not the EVB's
 * 0x21. `rx_delay` stays unset because `rgmii-rxid` has the PHY apply the RX
 * skew itself.
 */
&gmac0 {
	clock_in_out = "output";
	phy-mode = "rgmii-rxid";
	phy-handle = <&rgmii_phy0>;
	pinctrl-names = "default";
	pinctrl-0 = <&eth0m0_miim
		     &eth0m0_tx_bus2
		     &eth0m0_rx_bus2
		     &eth0m0_rgmii_clk
		     &eth0m0_rgmii_bus
		     &ethm0_clk0_25m_out>;
	tx_delay = <0x1b>;
	status = "okay";
};

&gpu {
	mali-supply = <&vdd_gpu_s0>;
	status = "okay";
};

/*
 * Enable vdd_gpu_s0 before the GPU power domain is powered. The RK3576 GPU
 * domain is fed by this rail; if the domain is toggled while the boot-on rail
 * has been disabled as unused (which a late, deferred panfrost probe races),
 * the power controller never acks the transition and panfrost's soft-reset
 * faults the unpowered block with an SError. Pairs with the rk3576-fixes
 * pmdomain patch that gives RK3576_PD_GPU a regulator and the pd_gpu label.
 */
&pd_gpu {
	domain-supply = <&vdd_gpu_s0>;
};

/*
 * gpio2 PB0 biases the HDMI data lines: the board drives it low for HDMI 2.1
 * FRL signalling and high for HDMI 1.4/2.0 TMDS, which is the active-low sense
 * of the encoder's `frl-enable` line.
 *
 * `pinctrl-0` restates the SoC's three default groups and then appends this
 * board's pin, because a board-level property assignment *replaces* the
 * inherited one rather than extending it. Listing `hdmi_frl_en` alone would
 * silently unmux everything rk3576.dtsi muxes for this controller:
 *
 *   hdmi_txm0_pins  gpio4 PC0 = CEC, gpio4 PC1 = hot-plug detect in
 *   hdmi_tx_scl     gpio4 PC2 = DDC clock  (EDID)
 *   hdmi_tx_sda     gpio4 PC3 = DDC data   (EDID)
 *
 * The m0 variant is this board's: the factory device tree muxes the same three
 * groups (bank 4 pins 16-19, function 9), and the m1 alternative on gpio0 goes
 * unused. Nothing else here claims gpio4 PC0-PC3.
 */
&hdmi {
	frl-enable-gpios = <&gpio2 RK_PB0 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmi_txm0_pins &hdmi_tx_scl &hdmi_tx_sda &hdmi_frl_en>;
	status = "okay";
};

&hdmi_in {
	hdmi_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi>;
	};
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&hdmi_sound {
	status = "okay";
};

&hdptxphy {
	status = "okay";
};

&i2c1 {
	status = "okay";

	rk806: pmic@23 {
		compatible = "rockchip,rk806";
		reg = <0x23>;
		interrupt-parent = <&gpio0>;
		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
		gpio-controller;
		#gpio-cells = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_pins>, <&rk806_dvs1_null>,
			    <&rk806_dvs2_null>, <&rk806_dvs3_null>;
		system-power-controller;

		vcc1-supply = <&vcc_sys>;
		vcc2-supply = <&vcc_sys>;
		vcc3-supply = <&vcc_sys>;
		vcc4-supply = <&vcc_sys>;
		vcc5-supply = <&vcc_sys>;
		vcc6-supply = <&vcc_sys>;
		vcc7-supply = <&vcc_sys>;
		vcc8-supply = <&vcc_sys>;
		vcc9-supply = <&vcc_sys>;
		vcc10-supply = <&vcc_sys>;
		vcc11-supply = <&vcc_2v0_pldo_s3>;
		vcc12-supply = <&vcc_sys>;
		vcc13-supply = <&vcc_1v1_nldo_s3>;
		vcc14-supply = <&vcc_1v1_nldo_s3>;
		vcca-supply = <&vcc_sys>;

		rk806_dvs1_null: dvs1-null-pins {
			pins = "gpio_pwrctrl1";
			function = "pin_fun0";
		};

		rk806_dvs2_null: dvs2-null-pins {
			pins = "gpio_pwrctrl2";
			function = "pin_fun0";
		};

		rk806_dvs3_null: dvs3-null-pins {
			pins = "gpio_pwrctrl3";
			function = "pin_fun0";
		};

		regulators {
			vdd_cpu_big_s0: dcdc-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_cpu_big_s0";
				regulator-enable-ramp-delay = <400>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			/*
			 * always-on because rocket cannot claim it: see the
			 * &rknn_core_0 note below.
			 */
			vdd_npu_s0: dcdc-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_npu_s0";
				regulator-enable-ramp-delay = <400>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_cpu_lit_s0: dcdc-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_cpu_lit_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vcc_3v3_s3: dcdc-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_3v3_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vdd_gpu_s0: dcdc-reg5 {
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <900000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_gpu_s0";
				regulator-enable-ramp-delay = <400>;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			vddq_ddr_s0: dcdc-reg6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vddq_ddr_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_logic_s0: dcdc-reg7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <800000>;
				regulator-name = "vdd_logic_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8_s3: dcdc-reg8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd2_ddr_s3: dcdc-reg9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vdd2_ddr_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vdd_ddr_s0: dcdc-reg10 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <1200000>;
				regulator-name = "vdd_ddr_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcca_1v8_s0: pldo-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcca_1v8_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcca1v8_pldo2_s0: pldo-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcca1v8_pldo2_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda_1v2_s0: pldo-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-name = "vdda_1v2_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcca_3v3_s0: pldo-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcca_3v3_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd_s0: pldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_sd_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcca1v8_pldo6_s3: pldo-reg6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcca1v8_pldo6_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd_0v75_s3: nldo-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "vdd_0v75_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vdda_ddr_pll_s0: nldo-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-name = "vdda_ddr_pll_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v75_hdmi_s0: nldo-reg3 {
				regulator-boot-on;
				regulator-min-microvolt = <837500>;
				regulator-max-microvolt = <837500>;
				regulator-name = "vdda0v75_hdmi_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda_0v85_s0: nldo-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-name = "vdda_0v85_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda_0v75_s0: nldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "vdda_0v75_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

/*
 * i2c2 stays disabled: this board populates nothing on it. The EVB design puts a
 * Haoyu HYM8563 RTC at 0x51 there, and the factory device tree carries the node,
 * but the chip is absent -- an i2cdetect sweep of the bus NAKs every address in
 * about 60 ms, which is a healthy bus reporting nothing home rather than a bus
 * fault. Declaring it anyway costs a guaranteed `rtc-hym8563 2-0051: could not
 * init device, -6` on every boot for a device that cannot answer.
 *
 * There is no RTC to substitute. The RK3576 has no on-chip RTC block (the TRM
 * describes none), and mainline exposes no RTC on the RK806 PMIC -- `rtc-rk808`
 * covers RK805/808/809/817/818 only, and the RK806 mfd cell list has no RTC cell.
 * So the board keeps no wall-clock time across power cycles and depends on NTP;
 * `/dev/rtc` does not exist. That is the hardware, not a gap in the config.
 */

&mdio0 {
	rgmii_phy0: ethernet-phy@1 {
		compatible = "ethernet-phy-id001c.c916";
		reg = <0x1>;
		clocks = <&cru REFCLKO25M_GMAC0_OUT>;
		assigned-clocks = <&cru REFCLKO25M_GMAC0_OUT>;
		assigned-clock-rates = <25000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&rgmii_phy0_rst>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio2 RK_PB3 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	hdmi {
		hdmi_frl_en: hdmi-frl-en {
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	ir {
		/* PWM0 IR pin as plain GPIO input; the demodulator drives it
		 * push-pull, so no bias (matches the vendor pinmux). */
		ir_receiver_pin: ir-receiver-pin {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	keys {
		pwr_key: pwr-key {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	network {
		rgmii_phy0_rst: rgmii-phy0-rst {
			rockchip,pins = <2 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		usb_host_pwren: usb-host-pwren {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wifi {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_reg_on: wifi-reg-on {
			rockchip,pins = <1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

};

/*
 * Reboot-mode register: the software half of the loader-mode path. `reboot
 * loader` from Linux writes mode-loader (BOOT_LOADER) to PMU0_GRF offset 0x40;
 * mainline u-boot reads it on the next boot and enters the rockusb gadget
 * (loader mode), so the box can be re-flashed with rkdeveloptool from a running
 * system -- no case, no maskrom. The magics match the vendor firmware's. Needs
 * CONFIG_SYSCON_REBOOT_MODE (socs/rk3576) on the kernel side and the
 * rk3576-loader profile's BOOT_LOADER handling on the u-boot side.
 */
&pmu0_grf {
	reboot-mode {
		compatible = "syscon-reboot-mode";
		offset = <0x40>;
		mode-normal = <0x5242c300>;
		mode-loader = <0x5242c301>;
		mode-bootloader = <0x5242c301>;
		mode-recovery = <0x5242c303>;
		mode-fastboot = <0x5242c309>;
		mode-ums = <0x5242c30c>;
	};
};

/*
 * The RKNN NPU, driven by the mainline `rocket` DRM-accel driver. Both compute
 * cores run. The SoC nodes come in disabled from the rk3576-npu patch series;
 * a board enables them and wires the rail.
 *
 * The rail needs regulator-always-on, *in addition to* npu-supply. Mainline
 * rocket references no regulator API, so npu-supply is inert and nothing claims
 * vdd_npu_s0; the regulator core then disables it as unused at t~33 s, long
 * after a clean probe at t~8 s. It presents as a runtime failure, not a boot
 * failure.
 *
 * The power domains are not a board's business: both core nodes carry both
 * RK3576_PD_NPU0 and RK3576_PD_NPU1 in the SoC dtsi, because the convolution
 * buffer is read through PD_NPU1 whichever core computes. rocket attaches
 * whatever the node lists, so trimming one would run half fed rather than fail;
 * the binding pins it at two. See rk3576/npu/README.md in the patches repo.
 */
&rknn_core_0 {
	npu-supply = <&vdd_npu_s0>;
	status = "okay";
};

&rknn_mmu_0 {
	status = "okay";
};

&rknn_core_1 {
	npu-supply = <&vdd_npu_s0>;
	status = "okay";
};

&rknn_mmu_1 {
	status = "okay";
};

/*
 * SAI1 drives the analog line-out amplifier. On this board the I2S data pin is
 * sdo2 (the EVB uses sdo0), and the 12.288 MHz master clock leaves on
 * sai1m0_mclk -- with the amplifier modelled as a pinless dummy codec, the SAI
 * owns the MCLK pin and rate rather than an I2C codec.
 *
 * `rockchip,sai-tx-route` is what makes the sdo2 choice real, and its value is not
 * what the binding's prose implies. Measured on this hardware: in SAI_PATH_SEL, TX
 * field *x* selects which TX data stream drives **SDO port x** -- the field index is
 * the port, the value is the stream. The driver writes entry *i* of this property
 * into field *i*, so reaching SDO port 2 takes three entries and the third is the
 * one that matters. `<0 1 0>` is the reset mapping with field 2 changed to stream 0,
 * i.e. sdo2 carries the playback stream.
 *
 * The binding documents `<3>` as "sdo3 is sending to data0", which would make the
 * index the data stream and the value the port -- the opposite assignment. Written
 * that way (`<2>`) the jack is silent: the engine streams, every clock and pin reads
 * correct, and the stream leaves on a port that reaches nothing. Confirmed by poking
 * SAI_PATH_SEL live and listening, one SDO port at a time.
 *
 * The array length also declares the lane count. Three here is an upper bound only:
 * stereo needs one lane, and hw_params clamps to what the channel count requires.
 */
&sai1 {
	assigned-clocks = <&cru CLK_SAI1_MCLKOUT_TO_IO>;
	assigned-clock-rates = <12288000>;
	pinctrl-names = "default";
	pinctrl-0 = <&sai1m0_lrck
		     &sai1m0_sclk
		     &sai1m0_sdi0
		     &sai1m0_sdo2
		     &sai1m0_mclk>;
	rockchip,sai-tx-route = <0 1 0>;
	status = "okay";
};

/* S/PDIF transmitter on the board's m1 pin group. */
&spdif_tx1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spdifm1_tx1>;
	status = "okay";
};

&sai6 {
	status = "okay";
};

&saradc {
	vref-supply = <&vcca_1v8_s0>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	full-pwr-cycle-in-suspend;
	max-frequency = <200000000>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	no-sdio;
	no-sd;
	non-removable;
	status = "okay";
};

/*
 * The AIC8800D80 Wi-Fi/BT module on SDIO. `non-removable` describes a soldered
 * part; the out-of-tree aic8800 driver claims it (the device's `device_kmods`).
 * `keep-power-in-suspend` is load-bearing rather than descriptive: that driver's
 * suspend callback returns early unless the host offers MMC_PM_KEEP_POWER, and
 * the callback is what parks the bus threads before the host loses its clock, so
 * without this the board does not survive a suspend. SDR104 signals at 1.8 V, so
 * the controller needs the bus I/O rail as `vqmmc-supply` to switch signalling --
 * `vccio_sd_s0` (RK806 PLDO5), the same rail the SD slot uses. `vcc_wifi_reg_on`
 * gates the module's own supply and is driven by the power sequence, separately.
 */
&sdio {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	disable-wp;
	keep-power-in-suspend;
	max-frequency = <100000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	no-mmc;
	no-sd;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1m0_bus4 &sdmmc1m0_clk &sdmmc1m0_cmd>;
	sd-uhs-sdr104;
	status = "okay";
	vqmmc-supply = <&vccio_sd_s0>;
};

/*
 * The microSD slot has no card-detect GPIO and no switchable card supply: the
 * controller's own detect pin reports insertion and the slot is always powered.
 */
&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	max-frequency = <200000000>;
	no-sdio;
	no-mmc;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	sd-uhs-sdr104;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&uart0 {
	status = "okay";
};

/*
 * UART4 (m1 pin group) carries the AIC8800D80 Bluetooth HCI. The BT firmware,
 * downloaded over SDIO during Wi-Fi bringup, is configured for 1.5 Mbaud with
 * hardware flow control, so the port needs its CTS/RTS lines. The BT core has no
 * in-tree serdev driver; the aic8800-bluetooth.service attaches the H4 line
 * discipline to the resulting /dev/ttyS4 (hciattach ... any 1500000 flow nosleep)
 * once BT_REG_ON and HST_WAK_BT are asserted -- which that same service does, not
 * the device tree; see the note below on why the lines are left undriven here.
 */
&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4m1_xfer &uart4m1_ctsn &uart4m1_rtsn>;
	uart-has-rtscts;
	status = "okay";
};

/*
 * The AIC8800D80's two Bluetooth control lines -- BT_REG_ON (PWR_BT, gpio1 PC7,
 * the BT-core enable) and HST_WAK_BT (host-wake-bluetooth, gpio1 PD4, active-high)
 * -- are named here but deliberately left undriven by the device tree. They are
 * driven high by aic8800-bluetooth.service instead: the controller comes out of
 * the SDIO firmware load in low-power sleep, and it is the low->high transition of
 * these lines *after* that load which wakes it. A static gpio-hog asserted at gpio
 * probe (before the firmware) gives no such edge and the controller never answers
 * HCI_Reset. The pins sit next to WL_REG_ON (PC6).
 */

&ufshc {
	status = "disabled";
};

/*
 * The USB 3.0 Type-A port, run as a High-Speed-only host on the USB2 PHY
 * alone. SuperSpeed link training on this board is marginal: a device
 * enumerates at SS, then collapses into a -62/-71 SetAddress loop the
 * host cannot reset out of, taking the boot medium with it. Capping the
 * speed requires BOTH properties: `maximum-speed` with the usbdp phy
 * still attached leaves the port dead (no connect at any speed), so the
 * SS phy is dropped from `phys` as well — the same pairing u-boot's
 * rk3576-generic.dts uses for this controller. To re-test SS (after
 * usbdp PHY tuning or with different hardware): delete both overrides
 * and re-enable &usbdp_phy with `rockchip,dp-lane-mux = <2 3>`.
 */
/*
 * `dis_u2_susphy_quirk` on both host controllers to fix an xHC resume error
 * (`xHC error in resume, USBSTS 0x401, Reinit`) after s2idle. The SoC dtsi sets
 * `dis_enblslpm_quirk`, which makes dwc3 assert BOTH the ENBLSLPM and SUSPHY bits
 * of GUSB2PHYCFG on host suspend, but the resume path clears SUSPHY only when
 * `dis_u2_susphy_quirk` is set — so without it the U2 PHY stays parked in suspend
 * across resume and the xHC faults. Setting the quirk restores that symmetry.
 */
&usb_drd0_dwc3 {
	dr_mode = "host";
	maximum-speed = "high-speed";
	phys = <&u2phy0_otg>;
	phy-names = "usb2-phy";
	snps,dis_u2_susphy_quirk;
	status = "okay";
};

/*
 * The USB 2.0 Type-A port. It keeps the SoC dtsi's SuperSpeed wiring -- the
 * combphy1_psu "usb3-phy" -- so the controller registers a SuperSpeed root hub,
 * but that PHY never comes ready (`2b060000.phy: wait phy status ready timeout`
 * on every boot) and nothing has enumerated above high speed here. Whether the
 * SS lane reaches a connector at all is unconfirmed; settle it by plugging a
 * SuperSpeed device into each port and reading which bus it lands on. If this
 * port is high-speed-only, drop the SS phy the way usb_drd0_dwc3 does above.
 *
 * Do not disable combphy1_psu along with it without testing that separately.
 * Combo PHY 1 is shared with PCIe1 and SATA1, and the SoC design guide (2.3.4.2)
 * states that with the mux set to PCIe or SATA the USB2 PHY on this controller
 * is unusable too -- so the enabled combphy may be what keeps the USB 2.0 port
 * alive, not just its SuperSpeed.
 */
&usb_drd1_dwc3 {
	dr_mode = "host";
	snps,dis_u2_susphy_quirk;
	status = "okay";
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vp0 {
	vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
		remote-endpoint = <&hdmi_in_vp0>;
	};
};
