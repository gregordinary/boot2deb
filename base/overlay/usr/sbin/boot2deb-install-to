#!/bin/sh
set -eu
# Install this system's embedded boot2deb image onto an internal disk.
#
# `boot2deb press --embed-image` places the recipe's own compressed image at
# /var/lib/boot2deb/install/, with a record beside it (<payload>.info) of the
# payload's sha256 and of the disk it decompresses to: its length and sha256. This
# script writes the image to a target disk from the booted board, the
# boot-from-card, install-to-eMMC workflow. It wraps the dd procedure with the
# checks a tired operator skips, and every check fails closed: a question it cannot
# get an answer to stops the install, since an unknown is not a yes.
#
# Before the target is touched:
#   - the payload hashes to its record, so a payload damaged on the card is never
#     half-written to a disk;
#   - the target is a whole, writable disk, by the kernel's own account;
#   - it is not, and does not hold, any device the running system's root sits on,
#     compared by device number through every layer (LVM, LUKS);
#   - nothing on it is mounted or held by another device;
#   - it is at least as large as the image;
#   - the operator types the target's name. There is no --yes.
#
# After the write, both ends of the pipe must have succeeded, and the disk is read
# back and held to the recorded image digest. Only then is the install reported
# done, so "done" means the image is on the disk, not that dd exited.
#
# The write overwrites the target completely. The image contains its own partition
# table and grows to fill the disk on its first boot.
#
# Re-running it is safe, and deliberately still writes: the operation is "put
# this image on that disk", not "provision the disk if it looks empty", so a
# repeat lands the identical bytes and a repeat after an interrupted write
# repairs it. Nothing is rescued off the target either: there is no separate boot
# partition to lose, since a combined image keeps /boot inside the root filesystem
# and the bootloader in the raw gap ahead of the partition table.

payload_dir=/var/lib/boot2deb/install
sysblock=/sys/block
devdir=/dev

usage() {
    echo "usage: boot2deb-install-to <whole-disk, e.g. /dev/mmcblk0>" >&2
    exit 64
}

fail() {
    echo "boot2deb-install-to: $*" >&2
    exit 1
}

[ "$#" -eq 1 ] || usage
target=$1
[ "$(id -u)" = 0 ] || fail "must run as root (sudo boot2deb-install-to $target)"

# Exactly one embedded payload: none means the image was pressed without
# --embed-image, several means leftovers to clean up first.
set -- "$payload_dir"/*.img.xz "$payload_dir"/*.img.gz
payload=''
for candidate in "$@"; do
    [ -e "$candidate" ] || continue
    [ -z "$payload" ] || fail "several embedded images under $payload_dir; remove all but one"
    payload=$candidate
done
[ -n "$payload" ] || fail "no embedded image under $payload_dir — this image was pressed without --embed-image"

case "$payload" in
    *.xz) decompress='xzcat' ;;
    *.gz) decompress='zcat' ;;
esac
for tool in "$decompress" sha256sum lsblk findmnt blockdev dd head; do
    command -v "$tool" >/dev/null 2>&1 || fail "$tool is not installed, and the install needs it"
done

# The record press wrote beside the payload. Every value is checked for shape, so a
# damaged record is a refusal rather than a comparison against garbage.
info="$payload.info"
[ -r "$info" ] || fail "no record beside $payload ($info) — press the image again"
rec_file='' rec_sha='' rec_bytes='' rec_image_sha=''
while IFS='=' read -r key value; do
    case "$key" in
        file) rec_file=$value ;;
        sha256) rec_sha=$value ;;
        image_bytes) rec_bytes=$value ;;
        image_sha256) rec_image_sha=$value ;;
    esac
done < "$info"
is_sha256() {
    [ "${#1}" -eq 64 ] && case "$1" in *[!0-9a-f]*) false ;; *) true ;; esac
}
[ "$rec_file" = "$(basename "$payload")" ] || fail "$info describes '$rec_file', not $(basename "$payload")"
is_sha256 "$rec_sha" || fail "$info records no valid sha256 for the payload"
is_sha256 "$rec_image_sha" || fail "$info records no valid sha256 for the image"
case "$rec_bytes" in ''|*[!0-9]*|0) fail "$info records no valid image size" ;; esac

# The payload is the one press recorded, checked before anything else is looked at:
# a card that rotted since it was pressed stops here, with the target untouched.
echo "checking $(basename "$payload") against its record"
have=$(sha256sum < "$payload") || fail "cannot read $payload"
have=${have%% *}
[ "$have" = "$rec_sha" ] || fail "$payload does not match its record (sha256 $have, recorded $rec_sha) — the card is damaged; press it again"

# The target must be a whole disk, by the kernel's account: a partition's sysfs
# entry lives under its parent rather than in /sys/block, and the type lsblk
# reports must be `disk`.
name=$(basename "$(readlink -f "$target")")
[ -n "$name" ] && [ -e "$sysblock/$name" ] || fail "$target is not a whole-disk block device (write to the disk, not a partition)"
dev="$devdir/$name"
[ -b "$dev" ] || fail "$dev is not a block device"
type=$(lsblk -dno TYPE "$dev") || fail "cannot ask lsblk what $dev is"
[ "$type" = disk ] || fail "$dev is a '$type', not a whole disk"
ro=$(cat "$sysblock/$name/ro") || fail "cannot read whether $dev is read-only"
[ "$ro" = 0 ] || fail "$dev is read-only"
majmin=$(lsblk -dno MAJ:MIN "$dev") || fail "cannot read the device number of $dev"
majmin=$(echo $majmin)
[ -n "$majmin" ] || fail "cannot read the device number of $dev"

# Never the disk this system runs from — that is the card being copied, not the
# disk being installed to, and there is deliberately no override. `lsblk -s` walks
# from the root's source up through every device-mapper layer to the disks under
# it, and each is compared by device number, which no spelling of a path changes.
# A root whose disks cannot be established is a refusal.
# `findmnt -v` names the device alone, without a btrfs root's `[/subvolume]`.
rootsrc=$(findmnt -nvo SOURCE /) || fail "cannot establish what / is mounted from"
[ -n "$rootsrc" ] || fail "cannot establish what / is mounted from"
chain=$(lsblk -lnso MAJ:MIN,TYPE "$rootsrc") || fail "cannot establish which disk $rootsrc sits on"
rootdisks=0
for line in $(printf '%s\n' "$chain" | while read -r mm t; do printf '%s,%s\n' "$mm" "$t"; done); do
    mm=${line%,*}
    t=${line#*,}
    [ "$mm" != "$majmin" ] || fail "$dev is the disk this system is running from"
    [ "$t" != disk ] || rootdisks=$((rootdisks + 1))
done
[ "$rootdisks" -gt 0 ] || fail "cannot establish which disk $rootsrc sits on"

# Nothing on the target may be in use: no mounted filesystem or swap, and no device
# (LVM, RAID, dm-crypt) holding the disk or any of its partitions.
mounts=$(lsblk -nlo MOUNTPOINT "$dev") || fail "cannot establish what is mounted from $dev"
for mounted in $mounts; do
    fail "$dev has $mounted mounted — unmount everything on it first"
done
for holders in "$sysblock/$name/holders" "$sysblock/$name"/"$name"*/holders; do
    [ -d "$holders" ] || continue
    for holder in "$holders"/*; do
        [ -e "$holder" ] || continue
        fail "$dev is in use by $(basename "$holder") — release it first"
    done
done

# The target has to hold the whole image. An unreadable size is a refusal: a disk
# found too small half way through the write is a disk with a broken image on it.
size=$(blockdev --getsize64 "$dev") || fail "cannot read the size of $dev"
case "$size" in ''|*[!0-9]*) fail "cannot read the size of $dev" ;; esac
[ "$size" -ge "$rec_bytes" ] || fail "$dev holds $size bytes, and the image needs $rec_bytes"

echo "about to overwrite $dev ($size bytes) with $(basename "$payload") ($rec_bytes bytes)"
printf 'type the device name (%s) to continue: ' "$name"
read -r answer || fail "no confirmation read; nothing written"
[ "$answer" = "$name" ] || fail "confirmation did not match; nothing written"

# The write, with both ends of the pipe checked: a shell reports only the last
# command's status, so a decompressor that fails after emitting a prefix would
# otherwise leave a cut-short image behind a successful dd.
status=$(mktemp -d) || fail "cannot create a scratch directory"
trap 'rm -rf "$status"' EXIT
{
    rc=0
    "$decompress" < "$payload" || rc=$?
    echo "$rc" > "$status/decompress"
} | {
    rc=0
    dd of="$dev" bs=4M conv=fsync 2> "$status/dd.err" || rc=$?
    echo "$rc" > "$status/dd"
}
[ "$(cat "$status/decompress")" = 0 ] || fail "$decompress failed part way; $dev holds a partial image — run the install again"
[ "$(cat "$status/dd")" = 0 ] || fail "writing $dev failed ($(tail -n 1 "$status/dd.err")); $dev holds a partial image"
sync

# Read the disk back and hold it to the recorded image digest. The buffer cache is
# dropped first, so the read comes from the disk rather than from what was just
# handed to it.
echo "verifying: reading $rec_bytes bytes back from $dev"
blockdev --flushbufs "$dev" || fail "cannot flush the buffers of $dev to verify it"
have=$(head -c "$rec_bytes" "$dev" | sha256sum) || fail "cannot read $dev back"
have=${have%% *}
[ "$have" = "$rec_image_sha" ] || fail "$dev does not hold the image after the write (sha256 $have, recorded $rec_image_sha) — the disk or its connection is failing; do not boot from it"

echo "done: $dev holds the image, verified. Power off, remove this boot medium, and the board boots from $dev."
