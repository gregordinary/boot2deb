#!/bin/sh
set -e
# boot2deb first-boot setup, run once by boot2deb-firstboot.service.
#
# One pass, no reboot: generate the device's ssh host keys, grow the root
# partition to fill the disk, and expand the filesystem onto it online. The
# kernel learns the partition's new size through BLKPG (`partx --update`),
# which works while the partition is mounted, so no partition-table re-read —
# and therefore no reboot — is needed.
#
# Identity is deliberately not touched. The build stamps one PARTUUID into the
# GPT, /etc/fstab, and the bootloader configuration (the extlinux cmdline, or
# the root= signed into the depthcharge kernel), and that value is the device's
# boot identity for life. Rewriting it here would open a window where the
# references and the disk disagree — a power cut inside that window is an
# unbootable device. The cost is that two devices flashed from the same image
# share identifiers, which only matters when both disks are attached to one
# machine at once; never boot with both attached.
#
# `done` in /var/lib/boot2deb marks completion and gates the unit off
# (ConditionPathExists). Every step below is idempotent, so a run that fails
# partway simply retries in full on the next boot.

state=/var/lib/boot2deb
done="$state/first-boot.done"
mkdir -p "$state"

# ssh-keygen -A creates only the missing host keys (the image ships with none --
# the build strips them so every device gets unique keys). Best-effort: a
# failure must not abort the rootfs grow below, so under `set -e` the ssh steps
# are guarded with `|| true`.
ssh-keygen -A || true
systemctl enable ssh.service || true

# Grow the root partition to fill the disk. sfdisk leaves every field the
# descriptor does not name unchanged, so the partition keeps its PARTUUID;
# --no-reread skips the full-table re-read that always fails on the disk
# holding the mounted root. partx tells the kernel the new size in place, and
# resize2fs grows the mounted filesystem online (the build formats with
# resize_inode and reserved GDT blocks, so online growth is the supported
# path up to the reserved ceiling).
rootdev="$(findmnt -no source /)"
partnum="$(echo "$rootdev" | grep -Eo '[[:digit:]]*$')"
disk="/dev/$(lsblk -no pkname "$rootdev")"
echo "size=+" | sfdisk --no-reread -f -N "$partnum" "$disk"
partx --update --nr "$partnum" "$disk"
resize2fs "$rootdev"

# Board-specific first-boot steps are drop-ins the boot-method and device
# overlays may supply, so the generic base stays portable: a target with no
# board-specific work simply has no hooks here. A hook that is present but not
# executable is a packaging fault, and it is fatal rather than skipped —
# silently passing over a load-bearing step produces a device that misbehaves
# with no trace of why. Failing here leaves the unit re-runnable.
if [ -d /etc/boot2deb/first-boot.d ]; then
    for hook in /etc/boot2deb/first-boot.d/*; do
        [ -e "$hook" ] || continue          # nothing to run; the glob did not match
        if [ ! -x "$hook" ]; then
            echo "first-boot hook $hook is not executable; refusing to skip it" >&2
            exit 1
        fi
        "$hook"
    done
fi

: > "$done"
systemctl disable boot2deb-firstboot.service || true
